# ============================================================
# AI Research Assistant — Backend Environment
# ============================================================

# APPLICATION
APP_NAME=AI Research Assistant
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true

# SERVER
HOST=127.0.0.1
PORT=8000

# SECURITY / JWT
# Generate a strong random value for your local .env
SECRET_KEY=replace-with-a-secure-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# DATABASE
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@127.0.0.1:5432/adaptive_rag
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# REDIS
REDIS_URL=redis://127.0.0.1:6379/0

# CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# RESEARCH PROVIDERS
OPENALEX_API_URL=https://api.openalex.org
SEMANTIC_SCHOLAR_API_URL=https://api.semanticscholar.org/graph/v1
CROSSREF_API_URL=https://api.crossref.org
ARXIV_API_URL=https://export.arxiv.org/api/query
SEMANTIC_SCHOLAR_API_KEY=

# HTTP PROVIDER SETTINGS
PROVIDER_TIMEOUT_SECONDS=30.0
PROVIDER_MAX_RETRIES=3

# LLM PROVIDER
LLM_PROVIDER=openrouter

# OPENROUTER
LLM_OPENROUTER_API_KEY=your-openrouter-api-key
LLM_OPENROUTER_MODEL=openrouter/free
LLM_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_OPENROUTER_HTTP_REFERER=http://localhost:3000
LLM_OPENROUTER_APP_NAME=AI Research Assistant

# GENERATION
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024
LLM_TOP_P=1.0
LLM_FREQUENCY_PENALTY=0.0
LLM_PRESENCE_PENALTY=0.0

LLM_TIMEOUT=120
LLM_MAX_RETRIES=3
LLM_STREAM=true
LLM_VERIFY_SSL=true

# LOGGING
LOG_LEVEL=INFO
LOG_FORMAT=standard

# SEARCH / PAGINATION
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
